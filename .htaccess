# ─── The Founder's Sprint — Cache & Security Headers ─────────────────
# Bluehost + Cloudflare: control what gets cached and for how long
#
# Bluehost sets max-age=14400 at the server level for static files.
# mod_headers (Header set/edit) cannot override it for JS/CSS.
# Fix: mod_expires sets max-age through a different Apache mechanism
# that DOES override the server default. Belt + suspenders.

# Enable rewrite engine
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ─── CACHE CONTROL via mod_expires ──────────────────────────────────
# mod_expires directly controls the max-age value in Cache-Control.
# This overrides Bluehost's server-level default (max-age=14400).

<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — no cache (0 seconds = always revalidate)
  ExpiresByType text/html "access plus 0 seconds"

  # CSS — 10 minutes
  ExpiresByType text/css "access plus 600 seconds"

  # JavaScript — 10 minutes
  ExpiresByType application/javascript "access plus 600 seconds"
  ExpiresByType text/javascript "access plus 600 seconds"
  ExpiresByType application/x-javascript "access plus 600 seconds"

  # Images — 7 days
  ExpiresByType image/jpeg "access plus 604800 seconds"
  ExpiresByType image/jpg "access plus 604800 seconds"
  ExpiresByType image/png "access plus 604800 seconds"
  ExpiresByType image/gif "access plus 604800 seconds"
  ExpiresByType image/webp "access plus 604800 seconds"
  ExpiresByType image/svg+xml "access plus 604800 seconds"
  ExpiresByType image/x-icon "access plus 604800 seconds"

  # Video — 30 days
  ExpiresByType video/mp4 "access plus 2592000 seconds"
  ExpiresByType video/webm "access plus 2592000 seconds"
  ExpiresByType video/ogg "access plus 2592000 seconds"

  # Fonts — 30 days
  ExpiresByType font/woff "access plus 2592000 seconds"
  ExpiresByType font/woff2 "access plus 2592000 seconds"
  ExpiresByType application/font-woff "access plus 2592000 seconds"
  ExpiresByType application/font-woff2 "access plus 2592000 seconds"

  # JSON — 10 minutes
  ExpiresByType application/json "access plus 600 seconds"
</IfModule>

# ─── ADDITIONAL HEADERS via mod_headers ─────────────────────────────

<IfModule mod_headers.c>

  # HTML — belt + suspenders: force no-cache even if mod_expires missed
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>

  # JS/CSS — add must-revalidate flag (mod_expires sets max-age)
  <FilesMatch "\.(css|js)$">
    Header append Cache-Control "must-revalidate"
  </FilesMatch>

  # ─── SECURITY HEADERS ────────────────────────────────────────────
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # HSTS — 6 months, THIS hostname only.
  # Deliberately NO includeSubDomains and NO preload:
  #   * Several subdomains (webmail, cpanel, whm, webdisk, ftp, ssh…) do not
  #     serve HTTPS on :443. includeSubDomains would make browsers refuse to
  #     reach them at all — locking us out of webmail/cPanel.
  #   * preload is baked into browsers and is effectively irreversible.
  # Ramp (raise max-age → includeSubDomains → preload) only AFTER the unused
  # cPanel/mail DNS records are deleted. See CLOUDFLARE_SECURITY_PLAN.md.
  Header always set Strict-Transport-Security "max-age=15552000"

  # security.txt must be served as plain text (RFC 9116)
  <Files "security.txt">
    Header set Content-Type "text/plain; charset=utf-8"
  </Files>

</IfModule>

# ─── .well-known — always reachable (RFC 9116 security.txt, ACME) ────
<IfModule mod_rewrite.c>
  RewriteRule ^\.well-known/ - [L]
</IfModule>

# ─── SHARED UI MODULES — always fresh, ZERO per-page cache-bust ─────
# site-chrome.js (nav + footer + hero shell), sponsors.js, auth-nav.js
# and taxonomy.js are loaded by EVERY page. Force them to revalidate on
# every request so that editing ONE file propagates site-wide — no ?v=
# bumps, no re-uploading every page. This overrides the 10-minute JS rule
# above for just these four files (mod_expires is the lever that actually
# beats Bluehost's server default; Header is belt + suspenders).
<FilesMatch "^(site-chrome|sponsors|auth-nav|taxonomy)\.js$">
  <IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType application/javascript "access plus 0 seconds"
    ExpiresByType text/javascript "access plus 0 seconds"
    ExpiresByType application/x-javascript "access plus 0 seconds"
  </IfModule>
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, must-revalidate"
  </IfModule>
</FilesMatch>

# ─── GZIP COMPRESSION ──────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ─── PREVENT DIRECTORY LISTING ──────────────────────────────────────
Options -Indexes

# ─── SOURCE / BACKUP EXPOSURE ───────────────────────────────────────
# The repo root IS the docroot, so anything uploaded is fetchable. Deny the
# things that should never be served even if they get uploaded by accident:
#   * editor/backup copies (founder.html.bak etc. leak full dashboard source)
#   * the explore test harness (its own README says "repo only")
#   * docs, SQL, logs, dotfiles, and the git directory
# Belt + braces: also delete these from the server — this only stops them
# being *served*, it doesn't remove them from disk.
<FilesMatch "(\.(bak|old|orig|save|swp|swo|sql|log|md|yml|yaml|ini|sh|env)|~)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  # /beta/explore/tests/** and any other tests directory
  RewriteRule (^|/)tests/ - [F,L]
  # never expose the git directory
  RewriteRule (^|/)\.git(/|$) - [F,L]
</IfModule>

# Dotfiles stay private — except .well-known (security.txt, ACME), allowed above.
<FilesMatch "^\.(?!well-known)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
