# ─── The Founder's Sprint — Cache & Security Headers ─────────────────
# Bluehost + Cloudflare: control what gets cached and for how long
#
# Bluehost sets max-age=14400 at the server level for static files.
# mod_headers (Header set/edit) cannot override it for JS/CSS.
# Fix: mod_expires sets max-age through a different Apache mechanism
# that DOES override the server default. Belt + suspenders.

# Enable rewrite engine
RewriteEngine On

# Custom 404
ErrorDocument 404 /404.html

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ─── Staging vs production ──────────────────────────────────────────
# Production lives at the web root (clean /… URLs). What remains reachable
# under /beta/ after the consolidation below is kept OUT of search results so
# it never competes with prod as duplicate content. (mod_setenvif + mod_headers.)
<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/beta/" FS_STAGING
</IfModule>
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow" env=FS_STAGING
</IfModule>

# ─── /beta/ consolidation — one copy of every page (7 Oct 2026) ─────
# /beta/ began as the staging copy we developed in. It became a SECOND FULL
# COPY of the site that had to be hand-synced, and the sync silently stopped
# happening: directory.html and apply-directory.html sat a whole shipped
# feature behind root (the service-keyword chips), and every book.js edit had
# to be made twice and diff-checked to prove the two hadn't diverged.
#
# 301 rather than delete, so that every link ever shared — a TikTok comment, a
# WhatsApp thread, an old email — keeps resolving, and so search folds any
# indexed /beta/ URL into its root twin instead of dropping it.
#
# Apache appends the original query string automatically (the substitution
# contains no "?"), so /beta/book/?tier=single&spec=x survives intact.
#
# THE EXCLUSIONS ARE THE LOAD-BEARING PART — each one would break something:
#   assets|images|Photos|endorsements — the ~66 MB of shared media. These live
#     ONLY under /beta/ and the fallback rule below exists to serve them from
#     there. Redirecting them would 404 every image and video on the site.
#   explore — the constellation discovery explorer, owned by a SEPARATE session
#     per the CLAUDE.md development boundary. Not ours to redirect or retire.
#   login — the auth portals. A magic-link or recovery URL carries its token in
#     the URL fragment; browsers do preserve a fragment across a 301, but
#     "almost certainly fine" is not a standard worth applying to the only door
#     into the platform. Left alone deliberately.
# THE_REQUEST, not REQUEST_URI — and this is the whole safety of the rule.
# The shared-media fallback below does an INTERNAL rewrite of /x → /beta/x, and
# Apache re-runs the ruleset after a rewrite. Guarded on REQUEST_URI this rule
# would fire on that internal path and 301 it straight back to /x, which the
# fallback would rewrite again: an infinite redirect, and a 500 once Apache hits
# its limit. The three stray .bak files in /beta (present there, absent at root)
# would have triggered exactly that. THE_REQUEST holds the raw first line of the
# HTTP request and is never touched by internal rewrites, so this fires ONLY
# when a browser genuinely asked for /beta/… and never on a re-entry.
#
# The exclusions sit in the pattern as a negative lookahead rather than in a
# RewriteCond for the same reason: the lookahead tests the path being matched in
# THIS iteration, with no ambiguity about which value a condition would see.
RewriteCond %{THE_REQUEST} \s/beta[/?\s]
RewriteRule ^beta/?$ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/beta/
RewriteRule ^beta/(?!assets/|images/|Photos/|endorsements/|explore/|login/)(.*)$ /$1 [R=301,L]

# ─── Specialty share links: /s/<slug> ───────────────────────────────
# Short, typeable URLs for the per-specialty landing pages, so a link dropped
# into a TikTok comment reads as founderssprint.co/s/pitch-deck-structure
# rather than a query string that social platforms mangle.
#
# ORDER MATTERS: this block MUST stay ABOVE the shared-media fallback below.
# That rule rewrites any not-found path to /beta/<path> and carries [L], so if
# it ran first a request for /s/<slug> would be sent to /beta/s/<slug>, find
# nothing, and 404 — the pages would be unreachable with no obvious cause.
#
# /s/<slug>/index.html is generated by tools/build-specialty-pages.js.
# Never hand-edit those files; re-run the generator instead.
#
# Guarded on the target existing, so a slug with no generated page falls
# through to the index rule rather than rewriting to a 404. Without this
# guard /s/index would rewrite to /s/index/index.html and dead-end.
RewriteCond %{DOCUMENT_ROOT}/s/$1/index.html -f
RewriteRule ^s/([a-z0-9][a-z0-9-]{0,78})/?$ /s/$1/index.html [L]

# An unknown or mistyped slug — the realistic failure when someone retypes a
# link from a comment — lands on the specialty index rather than a bare 404,
# or worse, an empty booking wizard with nothing selected.
# ^s/.+$ (not .*) so a request for /s/ itself cannot match and loop.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^s/.+$ /s/ [L,R=302]

# ─── Shared-media fallback ──────────────────────────────────────────
# Production pages live at the web root; the heavy static media (images,
# assets, Photos, endorsements) is kept in ONE place under /beta/ to avoid
# duplicating ~66 MB. If a request isn't found at the root but exists under
# /beta/, serve it from there. Also a safety net for any page not yet promoted.
RewriteCond %{REQUEST_URI} !^/beta/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/beta%{REQUEST_URI} -f [OR]
RewriteCond %{DOCUMENT_ROOT}/beta%{REQUEST_URI} -d
RewriteRule ^(.*)$ /beta/$1 [L]

# ─── CACHE CONTROL via mod_expires ──────────────────────────────────
# mod_expires directly controls the max-age value in Cache-Control.
# This overrides Bluehost's server-level default (max-age=14400).

<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — no cache (0 seconds = always revalidate)
  ExpiresByType text/html "access plus 0 seconds"

  # CSS — 10 minutes
  ExpiresByType text/css "access plus 600 seconds"

  # JavaScript — 10 minutes
  ExpiresByType application/javascript "access plus 600 seconds"
  ExpiresByType text/javascript "access plus 600 seconds"
  ExpiresByType application/x-javascript "access plus 600 seconds"

  # Images — 7 days
  ExpiresByType image/jpeg "access plus 604800 seconds"
  ExpiresByType image/jpg "access plus 604800 seconds"
  ExpiresByType image/png "access plus 604800 seconds"
  ExpiresByType image/gif "access plus 604800 seconds"
  ExpiresByType image/webp "access plus 604800 seconds"
  ExpiresByType image/svg+xml "access plus 604800 seconds"
  ExpiresByType image/x-icon "access plus 604800 seconds"

  # Video — 30 days
  ExpiresByType video/mp4 "access plus 2592000 seconds"
  ExpiresByType video/webm "access plus 2592000 seconds"
  ExpiresByType video/ogg "access plus 2592000 seconds"

  # Fonts — 30 days
  ExpiresByType font/woff "access plus 2592000 seconds"
  ExpiresByType font/woff2 "access plus 2592000 seconds"
  ExpiresByType application/font-woff "access plus 2592000 seconds"
  ExpiresByType application/font-woff2 "access plus 2592000 seconds"

  # JSON — 10 minutes
  ExpiresByType application/json "access plus 600 seconds"
</IfModule>

# ─── ADDITIONAL HEADERS via mod_headers ─────────────────────────────

<IfModule mod_headers.c>

  # HTML — belt + suspenders: force no-cache even if mod_expires missed
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>

  # JS/CSS — add must-revalidate flag (mod_expires sets max-age)
  <FilesMatch "\.(css|js)$">
    Header append Cache-Control "must-revalidate"
  </FilesMatch>

  # ─── SECURITY HEADERS ────────────────────────────────────────────
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # HSTS — 6 months, THIS hostname only.
  # Deliberately NO includeSubDomains and NO preload:
  #   * Several subdomains (webmail, cpanel, whm, webdisk, ftp, ssh…) do not
  #     serve HTTPS on :443. includeSubDomains would make browsers refuse to
  #     reach them at all — locking us out of webmail/cPanel.
  #   * preload is baked into browsers and is effectively irreversible.
  # Ramp (raise max-age → includeSubDomains → preload) only AFTER the unused
  # cPanel/mail DNS records are deleted. See CLOUDFLARE_SECURITY_PLAN.md.
  Header always set Strict-Transport-Security "max-age=15552000"

  # security.txt must be served as plain text (RFC 9116)
  <Files "security.txt">
    Header set Content-Type "text/plain; charset=utf-8"
  </Files>

</IfModule>

# ─── .well-known — always reachable (RFC 9116 security.txt, ACME) ────
<IfModule mod_rewrite.c>
  RewriteRule ^\.well-known/ - [L]
</IfModule>

# ─── SHARED UI MODULES — always fresh, ZERO per-page cache-bust ─────
# site-chrome.js (nav + footer + hero shell), sponsors.js, auth-nav.js
# and taxonomy.js are loaded by EVERY page. Force them to revalidate on
# every request so that editing ONE file propagates site-wide — no ?v=
# bumps, no re-uploading every page. This overrides the 10-minute JS rule
# above for just these four files (mod_expires is the lever that actually
# beats Bluehost's server default; Header is belt + suspenders).
<FilesMatch "^(site-chrome|sponsors|auth-nav|taxonomy)\.js$">
  <IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType application/javascript "access plus 0 seconds"
    ExpiresByType text/javascript "access plus 0 seconds"
    ExpiresByType application/x-javascript "access plus 0 seconds"
  </IfModule>
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, must-revalidate"
  </IfModule>
</FilesMatch>

# ─── GZIP COMPRESSION ──────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ─── PREVENT DIRECTORY LISTING ──────────────────────────────────────
Options -Indexes

# ─── SOURCE / BACKUP EXPOSURE ───────────────────────────────────────
# The repo root IS the docroot, so anything uploaded is fetchable. Deny the
# things that should never be served even if they get uploaded by accident:
#   * editor/backup copies (founder.html.bak etc. leak full dashboard source)
#   * the explore test harness (its own README says "repo only")
#   * docs, SQL, logs, dotfiles, and the git directory
# Belt + braces: also delete these from the server — this only stops them
# being *served*, it doesn't remove them from disk.
<FilesMatch "(\.(bak|old|orig|save|swp|swo|sql|log|md|yml|yaml|ini|sh|env)|~)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  # /beta/explore/tests/** and any other tests directory
  RewriteRule (^|/)tests/ - [F,L]
  # never expose the git directory
  RewriteRule (^|/)\.git(/|$) - [F,L]
</IfModule>

# Dotfiles stay private — except .well-known (security.txt, ACME), allowed above.
<FilesMatch "^\.(?!well-known)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
